;==============================================================================================================
;<説明>
;自宅環境でのTeraTerm学習中に作成したttlファイルです。
;TeraTermを使用するプロジェクトに参画開始したときに学習のために作成しました。
;本プログラムは、公開鍵認証による自動ログインと、ログイン後にシェルスクリプトを実行します。
;
;品質に問題がないことを確認したつもりではありますが、念のため実行前にコードチェックのうえ実行していただけますと幸いです。

;<作成情報>
;作成者  ：神部 慶太
;作成日  ：2026/08頃
;
;<処理内容>
;1)接続先設定情報で指定されたサーバに公開鍵認証でログインする
;2)Linux接続後、サーバのログファイルに接続に使用したマクロコマンドをログに出力する
;3)サーバのメタ情報を確認するスクリプトを実行し、結果を画面とログに出力する
;
;バージョン：v.0.0.1
;==============================================================================================================


;==============================================================================================================
;接続先 設定情報
;==============================================================================================================
HOSTADDR = '127.0.0.1'
USERNAME = 'user1'
KEY_FILE='C:\.ssh\id_ed25519'
PORT = '2222'
PROTOCOL = 'ssh'


;==============================================================================================================
;1)接続処理
;==============================================================================================================
CMD = HOSTADDR
strconcat CMD ':'
strconcat CMD PORT
strconcat CMD ' /'
strconcat CMD PROTOCOL
strconcat CMD ' /2'
strconcat CMD ' /auth=publickey'
strconcat CMD ' /user='
strconcat CMD USERNAME
strconcat CMD ' /keyfile='
strconcat CMD KEY_FILE
connect CMD

;==============================================================================================================
;2)接続コマンド 出力処理
;==============================================================================================================
wait '~]$ '
sendln 'echo ■ログインコマンド > metadata_check.log'

DMPCMD = 'echo connect '
strconcat DMPCMD CMD
strconcat DMPCMD ' >> metadata_check.log'

wait '~]$ '
sendln DMPCMD

wait '~]$ '
sendln 'echo  >> metadata_check.log'

;==============================================================================================================
;3)スクリプト実行
;==============================================================================================================
wait '~]$ '
sendln './metadata_check.sh | tee -a metadata_check.log'

settitle '学習用サーバ'
